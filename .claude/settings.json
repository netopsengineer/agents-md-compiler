{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/inject-discipline.sh",
            "args": [],
            "timeout": 10,
            "statusMessage": "Asserting operating discipline"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/enforce-done.sh",
            "args": [],
            "timeout": 180,
            "statusMessage": "Enforcing definition-of-done gate"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "axiom": {
      "source": {
        "source": "github",
        "repo": "netopsengineer/axiom"
      }
    }
  },
  "enabledPlugins": {
    "axiom-git@axiom": true,
    "axiom-versioning@axiom": true
  }
}
