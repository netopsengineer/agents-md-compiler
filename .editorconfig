# Canonical whitespace and line-ending rules. The compiler itself rejects CRLF
# and a missing final newline in any policy source it reads, so the repository
# holds itself to the same contract.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,toml}]
indent_size = 2

[*.md]
# Trailing whitespace is significant for Markdown hard line breaks; the linter
# owns Markdown structure instead.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
